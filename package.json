{
  "name": "effect-nats",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "bun run check:client && bun run check:agents",
    "check:client": "bun scripts/check.mjs",
    "check:agents": "bun run --filter effect-nats-agents typecheck",
    "test": "bun run test:client && bun run test:agents",
    "test:client": "vitest run",
    "test:agents": "bun run --filter effect-nats-agents test",
    "lint": "oxlint src test vitest.config.ts packages/agents/src",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test",
    "perf": "vitest run test/Transport.perf.test.ts",
    "leak": "bun scripts/leak-check.ts"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.111",
    "@types/node": "26.2.0",
    "dprint": "0.56.1",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "trustedDependencies": ["dprint"]
}
